{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "matt-jones.org company site: private S3 bucket served through CloudFront. No servers.",
  "Parameters": {
    "CertificateArn": {
      "Type": "String",
      "Default": "",
      "Description": "ACM certificate in us-east-1 covering matt-jones.org and www.matt-jones.org. Leave empty to serve only the cloudfront.net preview address."
    }
  },
  "Conditions": {
    "CustomDomain": {
      "Fn::Not": [{"Fn::Equals": [{"Ref": "CertificateArn"}, ""]}]
    }
  },
  "Resources": {
    "SiteBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {"Rules": [{"ObjectOwnership": "BucketOwnerEnforced"}]},
        "VersioningConfiguration": {"Status": "Enabled"},
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {"ServerSideEncryptionByDefault": {"SSEAlgorithm": "AES256"}}
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "ExpireOldVersions",
              "Status": "Enabled",
              "NoncurrentVersionExpiration": {"NoncurrentDays": 30},
              "AbortIncompleteMultipartUpload": {"DaysAfterInitiation": 7}
            }
          ]
        },
        "Tags": [
          {"Key": "service", "Value": "matt-jones-company"},
          {"Key": "env", "Value": "production"},
          {"Key": "managed-by", "Value": "cloudformation"}
        ]
      }
    },
    "SiteOAC": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {"Fn::Sub": "${AWS::StackName}-site"},
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "SiteIndex": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": {"Fn::Sub": "${AWS::StackName}-index"},
        "AutoPublish": true,
        "FunctionConfig": {
          "Comment": "Send www to matt-jones.org and resolve directory URLs",
          "Runtime": "cloudfront-js-2.0"
        },
        "FunctionCode": "function handler(event) {\n  var request = event.request;\n  var uri = request.uri.replace(/\\\\/g, '/').replace(/^\\/+/, '/');\n  request.uri = uri;\n  var host = request.headers && request.headers.host && request.headers.host.value;\n  var qs = request.querystring || {};\n  var parts = [];\n  Object.keys(qs).forEach(function(k) {\n    (qs[k].multiValue || [qs[k]]).forEach(function(v) { parts.push(k + '=' + v.value); });\n  });\n  var query = parts.length ? '?' + parts.join('&') : '';\n  if (host === 'www.matt-jones.org') {\n    return {statusCode: 302, statusDescription: 'Found', headers: {location: {value: 'https://matt-jones.org' + uri + query}}};\n  }\n  if (uri.endsWith('/')) request.uri += 'index.html';\n  else if (uri.split('/').pop().indexOf('.') === -1) {\n    return {statusCode: 301, statusDescription: 'Moved Permanently', headers: {location: {value: uri + '/' + query}}};\n  }\n  return request;\n}\n"
      }
    },
    "SiteDistribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "matt-jones-company",
          "DefaultRootObject": "index.html",
          "HttpVersion": "http2and3",
          "IPV6Enabled": true,
          "PriceClass": "PriceClass_100",
          "Origins": [
            {
              "Id": "site",
              "DomainName": {"Fn::GetAtt": ["SiteBucket", "RegionalDomainName"]},
              "OriginAccessControlId": {"Ref": "SiteOAC"},
              "S3OriginConfig": {"OriginAccessIdentity": ""}
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "site",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": ["GET", "HEAD", "OPTIONS"],
            "CachedMethods": ["GET", "HEAD"],
            "Compress": true,
            "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6",
            "ResponseHeadersPolicyId": "67f7725c-6f97-4210-82d7-5512b31e9d03",
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": {"Fn::GetAtt": ["SiteIndex", "FunctionARN"]}
              }
            ]
          },
          "CustomErrorResponses": [
            {"ErrorCode": 403, "ResponseCode": 404, "ResponsePagePath": "/404.html", "ErrorCachingMinTTL": 10},
            {"ErrorCode": 404, "ResponseCode": 404, "ResponsePagePath": "/404.html", "ErrorCachingMinTTL": 10}
          ],
          "ViewerCertificate": {
            "Fn::If": [
              "CustomDomain",
              {
                "AcmCertificateArn": {"Ref": "CertificateArn"},
                "SslSupportMethod": "sni-only",
                "MinimumProtocolVersion": "TLSv1.2_2021"
              },
              {"CloudFrontDefaultCertificate": true}
            ]
          },
          "Aliases": {
            "Fn::If": [
              "CustomDomain",
              ["matt-jones.org", "www.matt-jones.org"],
              {"Ref": "AWS::NoValue"}
            ]
          }
        },
        "Tags": [
          {"Key": "service", "Value": "matt-jones-company"},
          {"Key": "env", "Value": "production"},
          {"Key": "managed-by", "Value": "cloudformation"}
        ]
      }
    },
    "SiteBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {"Ref": "SiteBucket"},
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "CloudFrontOnly",
              "Effect": "Allow",
              "Principal": {"Service": "cloudfront.amazonaws.com"},
              "Action": "s3:GetObject",
              "Resource": {"Fn::Sub": "${SiteBucket.Arn}/*"},
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${SiteDistribution}"
                  }
                }
              }
            },
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {"Fn::GetAtt": ["SiteBucket", "Arn"]},
                {"Fn::Sub": "${SiteBucket.Arn}/*"}
              ],
              "Condition": {"Bool": {"aws:SecureTransport": "false"}}
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "BucketName": {"Value": {"Ref": "SiteBucket"}},
    "DistributionId": {"Value": {"Ref": "SiteDistribution"}},
    "DistributionDomainName": {"Value": {"Fn::GetAtt": ["SiteDistribution", "DomainName"]}}
  }
}
