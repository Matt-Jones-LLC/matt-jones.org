{
  "name": "coolmattgames.io HTTPS availability",
  "type": "api",
  "subtype": "http",
  "status": "paused",
  "message": "Website availability failed. Check the latest GitHub deployment, CloudFront distribution and S3 origin before changing DNS. Notify the site owner using the chosen Datadog notification handle.",
  "tags": [
    "service:cool-matt-games-lab",
    "env:experimental",
    "team:matt-jones-llc"
  ],
  "locations": [
    "aws:us-east-2"
  ],
  "config": {
    "request": {
      "method": "GET",
      "url": "https://coolmattgames.io/",
      "timeout": 30,
      "follow_redirects": true
    },
    "assertions": [
      {
        "type": "statusCode",
        "operator": "is",
        "target": 200
      },
      {
        "type": "responseTime",
        "operator": "lessThan",
        "target": 5000
      }
    ]
  },
  "options": {
    "tick_every": 900,
    "min_failure_duration": 1800,
    "min_location_failed": 1,
    "retry": {
      "count": 1,
      "interval": 300
    }
  }
}
