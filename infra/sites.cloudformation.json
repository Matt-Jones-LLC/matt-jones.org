{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Three isolated static sites: private S3, CloudFront OAC, scoped GitHub deployments. Preview hostnames only.",
  "Parameters": {
    "MonthlyBudgetUSD": {
      "Type": "Number",
      "Default": 30,
      "MinValue": 1,
      "MaxValue": 50
    },
    "BudgetEmail": {
      "Type": "String",
      "Description": "Email recipient for AWS budget alerts"
    },
    "CompanyCertificateArn": {
      "Type": "String",
      "Default": "",
      "Description": "Optional ISSUED ACM certificate in us-east-1 covering matt-jones.org and www.matt-jones.org"
    },
    "ArcadeCertificateArn": {
      "Type": "String",
      "Default": "",
      "Description": "Optional ISSUED ACM certificate in us-east-1 covering coolmatt.games and www.coolmatt.games"
    },
    "LabCertificateArn": {
      "Type": "String",
      "Default": "",
      "Description": "Optional ISSUED ACM certificate in us-east-1 covering coolmattgames.io and www.coolmattgames.io"
    }
  },
  "Resources": {
    "HostingBudget": {
      "Type": "AWS::Budgets::Budget",
      "Properties": {
        "Budget": {
          "BudgetName": {
            "Fn::Sub": "${AWS::StackName}-monthly"
          },
          "BudgetLimit": {
            "Amount": {
              "Ref": "MonthlyBudgetUSD"
            },
            "Unit": "USD"
          },
          "BudgetType": "COST",
          "TimeUnit": "MONTHLY"
        },
        "NotificationsWithSubscribers": [
          {
            "Notification": {
              "NotificationType": "ACTUAL",
              "ComparisonOperator": "GREATER_THAN",
              "Threshold": 80,
              "ThresholdType": "PERCENTAGE"
            },
            "Subscribers": [
              {
                "SubscriptionType": "EMAIL",
                "Address": {
                  "Ref": "BudgetEmail"
                }
              }
            ]
          },
          {
            "Notification": {
              "NotificationType": "ACTUAL",
              "ComparisonOperator": "GREATER_THAN",
              "Threshold": 100,
              "ThresholdType": "PERCENTAGE"
            },
            "Subscribers": [
              {
                "SubscriptionType": "EMAIL",
                "Address": {
                  "Ref": "BudgetEmail"
                }
              }
            ]
          },
          {
            "Notification": {
              "NotificationType": "FORECASTED",
              "ComparisonOperator": "GREATER_THAN",
              "Threshold": 100,
              "ThresholdType": "PERCENTAGE"
            },
            "Subscribers": [
              {
                "SubscriptionType": "EMAIL",
                "Address": {
                  "Ref": "BudgetEmail"
                }
              }
            ]
          }
        ]
      }
    },
    "CompanyBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "ExpireOldVersions",
              "Status": "Enabled",
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 30
              },
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 7
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "service",
            "Value": "matt-jones-company"
          },
          {
            "Key": "env",
            "Value": "production"
          },
          {
            "Key": "managed-by",
            "Value": "cloudformation"
          }
        ]
      }
    },
    "CompanyOAC": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-matt-jones-company"
          },
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "CompanyIndex": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-company-index"
        },
        "AutoPublish": true,
        "FunctionConfig": {
          "Comment": "Preserve directory URLs and relative assets",
          "Runtime": "cloudfront-js-2.0"
        },
        "FunctionCode": "function handler(event) {\n  var request = event.request;\n  var uri = request.uri;\n  var host = request.headers && request.headers.host && request.headers.host.value;\n  var canonical = {'www.matt-jones.org':'matt-jones.org','www.coolmatt.games':'coolmatt.games','www.coolmattgames.io':'coolmattgames.io'};\n  if (canonical[host]) {\n    var query = [];\n    Object.keys(request.querystring || {}).forEach(function(k) {\n      var item = request.querystring[k];\n      (item.multiValue || [item]).forEach(function(v) { query.push(k + '=' + v.value); });\n    });\n    return {statusCode:301,statusDescription:'Moved Permanently',headers:{location:{value:'https://' + canonical[host] + uri + (query.length ? '?' + query.join('&') : '')}}};\n  }\n  if (uri.endsWith('/')) request.uri += 'index.html';\n  else if (uri.split('/').pop().indexOf('.') === -1) {\n    var parts = [];\n    var qs = request.querystring || {};\n    Object.keys(qs).forEach(function(k) {\n      var vals = qs[k].multiValue || [qs[k]];\n      vals.forEach(function(v) { parts.push(k + '=' + v.value); });\n    });\n    return {statusCode: 301, statusDescription: 'Moved Permanently', headers: {location: {value: uri + '/' + (parts.length ? '?' + parts.join('&') : '')}}};\n  }\n  return request;\n}\n"
      }
    },
    "CompanyDistribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "matt-jones-company",
          "DefaultRootObject": "index.html",
          "HttpVersion": "http2and3",
          "IPV6Enabled": true,
          "PriceClass": "PriceClass_100",
          "Origins": [
            {
              "Id": "site",
              "DomainName": {
                "Fn::GetAtt": [
                  "CompanyBucket",
                  "RegionalDomainName"
                ]
              },
              "OriginAccessControlId": {
                "Ref": "CompanyOAC"
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "site",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD",
              "OPTIONS"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6",
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": {
                  "Fn::GetAtt": [
                    "CompanyIndex",
                    "FunctionARN"
                  ]
                }
              }
            ]
          },
          "CustomErrorResponses": [
            {
              "ErrorCode": 403,
              "ResponseCode": 404,
              "ResponsePagePath": "/404.html",
              "ErrorCachingMinTTL": 10
            },
            {
              "ErrorCode": 404,
              "ResponseCode": 404,
              "ResponsePagePath": "/404.html",
              "ErrorCachingMinTTL": 10
            }
          ],
          "ViewerCertificate": {
            "Fn::If": [
              "CompanyCustomDomain",
              {
                "AcmCertificateArn": {
                  "Ref": "CompanyCertificateArn"
                },
                "SslSupportMethod": "sni-only",
                "MinimumProtocolVersion": "TLSv1.2_2021"
              },
              {
                "CloudFrontDefaultCertificate": true
              }
            ]
          },
          "Aliases": {
            "Fn::If": [
              "CompanyCustomDomain",
              [
                "matt-jones.org",
                "www.matt-jones.org"
              ],
              {
                "Ref": "AWS::NoValue"
              }
            ]
          }
        },
        "Tags": [
          {
            "Key": "service",
            "Value": "matt-jones-company"
          },
          {
            "Key": "env",
            "Value": "production"
          },
          {
            "Key": "managed-by",
            "Value": "cloudformation"
          }
        ]
      }
    },
    "CompanyBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "CompanyBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "CloudFrontOnly",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${CompanyBucket.Arn}/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${CompanyDistribution}"
                  }
                }
              }
            },
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "CompanyBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${CompanyBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "CompanyDeployRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Ref": "GitHubOidcProvider"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": "repo:Matt-Jones-LLC/matt-jones.org:ref:refs/heads/main"
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "PublishOneSite",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "CompanyBucket",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${CompanyBucket.Arn}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudfront:CreateInvalidation",
                    "cloudfront:GetInvalidation"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${CompanyDistribution}"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "service",
            "Value": "matt-jones-company"
          },
          {
            "Key": "env",
            "Value": "production"
          },
          {
            "Key": "managed-by",
            "Value": "cloudformation"
          }
        ]
      }
    },
